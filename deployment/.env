export TF_VAR_cloudflare_account_id="op://tf/cloudflare/account_id"
export TF_VAR_cloudflare_api_token="op://tf/cloudflare/api_token"
# o11y vmauth gateway token for the env's store (tf_dev: staging, tf_prod: production).
export TF_VAR_o11y_vmauth_token="op://tf_$ENVIRONMENT/O11Y_VICTORIAMETRICS_VMAUTH_PASSWORD/password"
export TF_VAR_tf_state_postgres_conn_str="op://tf/tf_state/postgres_conn_str"

# Only until the tiles-worker apply has destroyed the old monitoring.immich.cloud dashboards and alerts.
export TF_VAR_grafana_token="op://tf_$ENVIRONMENT/MONITORING_GRAFANA_TF_AUTH_TOKEN/password"
export TF_VAR_grafana_url="op://tf_$ENVIRONMENT/MONITORING_GRAFANA_URL/password"

export TF_VAR_tigris_read_key_id="op://tf/TIGRIS_READ_KEY_ID/password"
export TF_VAR_tigris_read_access_key="op://tf/TIGRIS_READ_ACCESS_KEY/password"

export TF_VAR_tigris_admin_access_key="op://tf/TIGRIS_ADMIN_KEY_ID/password"
export TF_VAR_tigris_admin_secret_key="op://tf/TIGRIS_ADMIN_ACCESS_KEY/password"

export TF_VAR_env=$ENVIRONMENT
