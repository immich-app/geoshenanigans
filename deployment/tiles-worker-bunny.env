# The Bunny account API key and the Globalping token for the tiles worker's cron (Bunny request logs and the synthetic
# probe), which tiles-worker puts on the worker in prod only, as Worker secrets through Cloudflare's API and never in its
# state (terraform_data.bunny_secrets). Resolved beside .env by prod applies of tiles-worker only (the Tiles Worker
# workflow on main, Tiles Deploy's prod activation), with the tiles-bunny environment's service account: the tf_bunny
# vault is out of reach of the tokens pull requests' plans get (modules/bunny/tiles/README.md).
export TF_VAR_bunny_api_key="op://tf_bunny/BUNNY_API_KEY/password"
export TF_VAR_globalping_token="op://tf_bunny/GLOBALPING_TOKEN/password"
