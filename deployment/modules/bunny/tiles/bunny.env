# This module's secrets, resolved by `op run --env-file` (README.md). Run with ENVIRONMENT=prod: the Bunny account is
# production only and there is no dev zone.
export TF_VAR_tf_state_postgres_conn_str="op://tf/tf_state/postgres_conn_str"
export TF_VAR_bunny_api_key="op://tf_$ENVIRONMENT/BUNNY_API_KEY/password"

export TF_VAR_env=$ENVIRONMENT
