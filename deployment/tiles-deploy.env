# Tigris access for the tiles deploy scripts and tiles-cleanup.sh, resolved by `op run --env-file`.
export TIGRIS_KEY_ID="op://tf/TIGRIS_ADMIN_KEY_ID/password"
export TIGRIS_ACCESS_KEY="op://tf/TIGRIS_ADMIN_ACCESS_KEY/password"
export RCLONE_CONFIG_TIGRIS_TYPE="s3"
export RCLONE_CONFIG_TIGRIS_PROVIDER="Other"
export RCLONE_CONFIG_TIGRIS_ENDPOINT="https://fly.storage.tigris.dev"
export RCLONE_CONFIG_TIGRIS_ACCESS_KEY_ID="op://tf/TIGRIS_ADMIN_KEY_ID/password"
export RCLONE_CONFIG_TIGRIS_SECRET_ACCESS_KEY="op://tf/TIGRIS_ADMIN_ACCESS_KEY/password"
