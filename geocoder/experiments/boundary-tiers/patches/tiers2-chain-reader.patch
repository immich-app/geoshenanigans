@@ -2978,6 +2978,32 @@ impl Index {
 
     // --- Combined query ---
 
+    // tiers2 candidate (g): the finest admin polygon (admin_level 3..=10)
+    // whose ring contains the point, smallest area within a level, as the
+    // chain walk's start.
+    fn finest_admin_polygon(&self, lat: f64, lng: f64) -> Option<u32> {
+        let cell = cell_id_at_level(lat, lng, self.admin_cell_level);
+        let neighbors = cell_neighbors_at_level(cell, self.admin_cell_level);
+        let mut best: [Option<(f32, u32)>; 11] = [None; 11];
+        let mut seen: Vec<u32> = Vec::new();
+        for c in std::iter::once(cell).chain(neighbors.into_iter()) {
+            Self::for_each_entry_fb(&self.admin_entries, Self::lookup_admin_cell_fb(&self.admin_cells, c), |id| {
+                let poly_id = id & ID_MASK;
+                if seen.contains(&poly_id) { return; }
+                seen.push(poly_id);
+                let Some(poly) = self.admin_polygon(poly_id) else { return; };
+                let level = poly.admin_level as usize;
+                if !(3..=10).contains(&level) || poly.area <= 0.0 { return; }
+                if let Some((a, _)) = best[level] { if poly.area >= a { return; } }
+                let Some(verts) = self.admin_verts(&poly) else { return; };
+                if point_in_polygon(lat as f32, lng as f32, &verts) {
+                    best[level] = Some((poly.area, poly_id));
+                }
+            });
+        }
+        (3..=10).rev().find_map(|l| best[l].map(|(_, id)| id))
+    }
+
