+        3 => pip_grid(&bytes, 8, lat, lng, bmin_lat, bmin_lng, scale, |b| (u32_at(b, 0) as i64, u32_at(b, 4) as i64)),
+        _ => pip_grid(&bytes, 4, lat, lng, bmin_lat, bmin_lng, scale, |b| {
+            (u16::from_le_bytes([b[0], b[1]]) as i64, u16::from_le_bytes([b[2], b[3]]) as i64)
         }),
     })
 }
 
+/// Largest k with (base + k * scale) as f32 <= x. The decoded value is monotone in k, so a vertex
+/// decodes above x exactly when its k is above this threshold.
+#[inline]
+pub fn grid_threshold(x: f32, base: f64, scale: f64) -> i64 {
+    let mut k = ((x as f64 - base) / scale).floor() as i64;
+    while ((base + k as f64 * scale) as f32) > x { k -= 1; }
+    while ((base + (k + 1) as f64 * scale) as f32) <= x { k += 1; }
+    k
+}
+
+/// `pip_vertices` over quantized vertices (k_lat, k_lng) decoding to f32(bmin + k * scale): the
+/// straddle test runs on the integers, only straddling edges decode (same answers).
+#[inline]
+fn pip_grid(bytes: &[u8], stride: usize, lat: f32, lng: f32, bmin_lat: f64, bmin_lng: f64, scale: f64,
+            at: impl Fn(&[u8]) -> (i64, i64)) -> bool {
+    let t = grid_threshold(lng, bmin_lng, scale);
+    let n = bytes.len() / stride;
+    let mut inside = false;
+    let (mut kj_lat, mut kj_lng) = at(&bytes[(n - 1) * stride..]);
+    let mut j_above = kj_lng > t;
+    for c in bytes.chunks_exact(stride) {
+        let (ki_lat, ki_lng) = at(c);
+        let i_above = ki_lng > t;
+        if i_above != j_above {
+            let vi_lat = (bmin_lat + ki_lat as f64 * scale) as f32;
+            let vi_lng = (bmin_lng + ki_lng as f64 * scale) as f32;
+            let vj_lat = (bmin_lat + kj_lat as f64 * scale) as f32;
+            let vj_lng = (bmin_lng + kj_lng as f64 * scale) as f32;
+            if lat < (vj_lat - vi_lat) * (lng - vi_lng) / (vj_lng - vi_lng) + vi_lat {
+                inside = !inside;
+            }
+        }
+        kj_lat = ki_lat;
+        kj_lng = ki_lng;
+        j_above = i_above;
+    }
+    inside
+}
+
