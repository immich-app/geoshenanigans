--- a/geocoder/server/src/lib.rs
+++ b/geocoder/server/src/lib.rs
@@ -4093,17 +4093,55 @@ pub fn point_in_encoded_polygon(src: &FileBytes, vertex_offset: u32, vertex_coun
     let scale = vertex_scale(encoding);
     let u16_at = |b: &[u8], i: usize| u16::from_le_bytes([b[i], b[i + 1]]) as f64;
     let u32_at = |b: &[u8], i: usize| u32::from_le_bytes([b[i], b[i + 1], b[i + 2], b[i + 3]]);
+    let _ = u16_at;
