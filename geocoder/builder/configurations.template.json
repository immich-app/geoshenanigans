{
  "schema_version": 1,
  "build": {
    "version": 24,
    "patch_version": 19
  },
  "attribution": [
    {
      "id": "osm",
      "text": "© OpenStreetMap contributors",
      "url": "https://www.openstreetmap.org/copyright",
      "licence": "ODbL 1.0",
      "licence_url": "https://opendatacommons.org/licenses/odbl/1-0/",
      "notices": [
        "This dataset is a derivative database of OpenStreetMap, available under the ODbL 1.0."
      ],
      "applies_to": [
        "mode.*",
        "dir.*",
        "quality.*",
        "poi_tier.*",
        "water.*"
      ]
    },
    {
      "id": "marine-regions",
      "text": "Flanders Marine Institute (2024). The intersect of the Exclusive Economic Zones and IHO sea areas, version 5. Available online at https://www.marineregions.org/. https://doi.org/10.14284/699",
      "url": "https://www.marineregions.org/",
      "licence": "CC BY 4.0",
      "licence_url": "https://creativecommons.org/licenses/by/4.0/",
      "notices": [
        "Changes: each IHO sea area's parts in every EEZ dissolved into one, cut to the water off OpenStreetMap's land polygons and along a 1-degree grid, and simplified in the simplified tiers. Cut to OpenStreetMap's land, the areas are part of this dataset's ODbL derivative database."
      ],
      "applies_to": [
        "water.major",
        "water.all",
        "water.all-exact"
      ]
    }
  ],
  "axes": {
    "region": {
      "label": "Region",
      "description": "Geographic coverage area",
      "order": 1,
      "values": {
        "planet": {
          "label": "Planet (entire world)",
          "order": 1
        },
        "europe": {
          "label": "Europe",
          "order": 2
        },
        "asia": {
          "label": "Asia",
          "order": 3
        },
        "north-america": {
          "label": "North America",
          "order": 4
        },
        "south-america": {
          "label": "South America",
          "order": 5
        },
        "africa": {
          "label": "Africa",
          "order": 6
        },
        "oceania": {
          "label": "Oceania",
          "order": 7
        },
        "central-america": {
          "label": "Central America",
          "order": 8
        },
        "antarctica": {
          "label": "Antarctica",
          "order": 9
        }
      }
    },
    "mode": {
      "label": "Coverage detail",
      "description": "How much road and address data to include alongside admin boundaries",
      "order": 2,
      "values": {
        "full": {
          "label": "Full",
          "description": "Streets + addresses + interpolation + admin + postcodes. Largest, most complete.",
          "order": 1
        },
        "no-addresses": {
          "label": "No addresses",
          "description": "Streets + admin + postcodes. No house-number resolution.",
          "order": 2
        },
        "admin": {
          "label": "Admin only",
          "description": "Admin boundaries + place nodes + postcodes. No streets or addresses.",
          "order": 3
        },
        "admin-minimal": {
          "label": "Admin minimal",
          "description": "Admin boundaries (within 37.5 m, on an 11 m grid) + place nodes only — no postcodes, no postcode areas. Smallest possible deployable. Country/state/city + cities500-equivalent place names.",
          "order": 4
        }
      }
    },
    "quality": {
      "label": "Boundary precision",
      "description": "Each border is stored once, shared by the boundaries on either side of it. Default simplified is invisible at typical photo-GPS accuracy.",
      "order": 3,
      "values": {
        "exact": {
          "label": "Exact",
          "precision_m": 0,
          "description": "Every OSM point.",
          "order": 1
        },
        "simplified": {
          "label": "Simplified",
          "precision_m": 37.5,
          "description": "~37 m boundaries, shared by neighbours.",
          "order": 2
        }
      }
    },
    "poi_tier": {
      "label": "Points of interest",
      "description": "Landmarks, parks, museums, peaks, airports, etc.",
      "order": 4,
      "values": {
        "none": {
          "label": "None",
          "description": "No POI data.",
          "order": 1
        },
        "major": {
          "label": "Major (~900K POIs)",
          "description": "Airports, national parks, palaces, train stations, UNESCO sites, volcanoes.",
          "order": 2
        },
        "notable": {
          "label": "Notable (~3.8M POIs)",
          "description": "+ museums, castles, stadiums, beaches, waterfalls, universities, viewpoints.",
          "order": 3
        },
        "all": {
          "label": "All (~24.5M POIs)",
          "description": "Every named POI (places of worship, peaks, memorials, artwork, gardens).",
          "order": 4
        }
      }
    },
    "water": {
      "label": "Bodies of water",
      "description": "Seas, oceans, lakes, rivers, canals, bays, straits, wetlands and glaciers as areas: the files of a water/ dir of their own beside the dataset's, published to download, which the server and its downloader don't read yet. Any boundary precision takes any of them.",
      "order": 5,
      "values": {
        "none": {
          "label": "None",
          "description": "No water areas.",
          "order": 1
        },
        "major": {
          "label": "Major (~98K areas)",
          "precision_m": 37.5,
          "description": "The seas and oceans; lakes, bays, straits, wetlands and glaciers of 100 km² or more; and whole rivers and canals whose areas sum to 100 km², or 5 km² with a Wikidata item. ~37 m shores.",
          "order": 2
        },
        "all": {
          "label": "All (~1.24M areas)",
          "precision_m": 37.5,
          "description": "Every named body of water mapped as an area, every river or canal area its waterway names, and the seas and oceans. ~37 m shores.",
          "order": 3
        },
        "all-exact": {
          "label": "All, exact shores",
          "precision_m": 0,
          "description": "As All, with every OSM point of every shore.",
          "order": 4
        }
      }
    }
  },
  "constraints": [
    {
      "id": "admin-minimal-needs-simplified",
      "when": {
        "mode": "admin-minimal"
      },
      "requires": {
        "quality": "simplified"
      },
      "message": "Admin minimal mode is only built with simplified boundaries — the whole point is the smallest possible deployable."
    }
  ],
  "components": {
    "mode.admin-minimal": {
      "variants": [
        {
          "when": {
            "poi_tier": "none"
          },
          "component": "dir.admin-minimal"
        },
        {
          "component": "dir.admin-minimal-poi"
        }
      ]
    },
    "dir.admin-minimal": {
      "description": "Admin minimal without POIs: its own polygon slots and only the core strings its records name.",
      "files": [
        "{region}/admin-minimal/admin_cells.bin",
        "{region}/admin-minimal/admin_entries.bin",
        "{region}/admin-minimal/admin_polygons.bin",
        "{region}/admin-minimal/admin_rings.bin",
        "{region}/admin-minimal/arc_index.bin",
        "{region}/admin-minimal/arc_vertices.bin",
        "{region}/admin-minimal/place_cells.bin",
        "{region}/admin-minimal/place_hidden.bin",
        "{region}/admin-minimal/place_nodes.bin",
        "{region}/admin-minimal/strings_core.bin",
        "{region}/admin-minimal/strings_layout.json"
      ],
      "replaces": [
        "{region}/quality/{quality}/admin_polygons.bin",
        "{region}/quality/{quality}/admin_rings.bin",
        "{region}/quality/{quality}/arc_index.bin",
        "{region}/quality/{quality}/arc_vertices.bin"
      ]
    },
    "dir.admin-minimal-poi": {
      "description": "Admin minimal beside a POI tier: the shared polygon slots and core strings, which the POI tier's parent polygons and names point into.",
