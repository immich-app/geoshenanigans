  "presets": [
    {
      "id": "smallest",
      "label": "Smallest useful",
      "description": "Admin boundaries + cities500-level place names, no POIs.",
      "selections": {
        "region": "planet",
        "mode": "admin-minimal",
        "quality": "simplified",
        "poi_tier": "none",
        "water": "none"
      }
    },
    {
      "id": "immich-recommended",
      "label": "Immich recommended",
      "description": "Admin + major POIs (airports, parks, palaces). Best balance for photo apps.",
      "selections": {
        "region": "planet",
        "mode": "admin",
        "quality": "simplified",
        "poi_tier": "major",
        "water": "none"
      },
      "default": true
    },
    {
      "id": "with-addresses",
      "label": "With street addresses",
      "description": "Streets + addresses + interpolation. House-number resolution where tagged.",
      "selections": {
        "region": "planet",
        "mode": "full",
        "quality": "simplified",
        "poi_tier": "all",
        "water": "none"
      }
    },
    {
      "id": "max-quality",
      "label": "Maximum quality",
      "description": "Full mode with exact boundaries, every OSM point. Largest configuration available.",
      "selections": {
        "region": "planet",
        "mode": "full",
        "quality": "exact",
        "poi_tier": "all",
        "water": "none"
      }
    }
  ],
  "search_index": {
    "description": "Place search index of one selection. The selections in `shipped` (those it adds at most 5% to on planet, zstd; builder/PATCHING.md) publish it in every region under `dir` (download each file into <dataset>/search/); any other selection builds it on the device from its own files.",
    "dir": "{region}/search/{mode}/{quality}/{poi_tier}",
    "files": [
      "places.fst",
      "places.post",
      "places.pfx.fst",
      "places.pfx",
      "places.bnd",
      "search_meta.json"
    ],
    "optional_files": [
      "poi.fst",
      "poi.post",
      "poi.pfx.fst",
      "poi.pfx"
    ],
    "shipped": [
      {
        "mode": "full",
        "quality": "simplified",
        "poi_tier": "all"
      },
      {
        "mode": "full",
        "quality": "exact",
        "poi_tier": "all"
      }
    ]
  },
  "transport": {
    "description": "Transport units: the download-only form of the files they hold, their values in byte-aligned columns, which compress better than the packed files (query_server::transport). Every dir holding all of a unit's files publishes the unit as <dir>/<unit>, and that is the only published form of those files: a client fetches the unit once and decodes it into them (the query-server library, the node binding or the geocoder-transport CLI), each checked against its sha256 in `files`. `units` lists each unit of the build with its kind, version, size and files; a file's `unit` names the one that holds it.",
    "version": 1,
    "units": [
      {
        "unit": "places.tt.zst",
        "kind": "places",
        "files": [
          "place_cells.bin",
          "place_nodes.bin",
          "place_hidden.bin"
        ]
      },
      {
        "unit": "pois.tt.zst",
        "kind": "pois",
        "files": [
          "poi_records.bin",
          "poi_vertices.bin"
        ]
      },
      {
        "unit": "arcs.tt.zst",
        "kind": "arcs",
        "files": [
          "arc_index.bin",
          "arc_vertices.bin"
        ]
      },
      {
        "unit": "admin_polygons.tt.zst",
        "kind": "cols",
        "files": [
          "admin_polygons.bin"
        ]
      },
      {
        "unit": "street_ways.tt.zst",
        "kind": "cols",
        "files": [
          "street_ways.bin"
        ]
      },
      {
        "unit": "interp_ways.tt.zst",
        "kind": "cols",
        "files": [
          "interp_ways.bin"
        ]
      },
      {
        "unit": "addr_index.tt.zst",
        "kind": "cols",
        "files": [
          "addr_index.bin"
        ]
      }
    ]
  },
  "files": {}
}
