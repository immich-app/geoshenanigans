        "{region}/admin-minimal-poi/place_cells.bin",
        "{region}/admin-minimal-poi/place_hidden.bin",
        "{region}/admin-minimal-poi/place_nodes.bin",
        "{region}/admin-minimal-poi/strings_core.bin",
        "{region}/admin-minimal-poi/strings_layout.json"
      ],
      "replaces": [
        "{region}/quality/{quality}/admin_polygons.bin",
        "{region}/quality/{quality}/admin_rings.bin",
        "{region}/quality/{quality}/arc_index.bin",
        "{region}/quality/{quality}/arc_vertices.bin"
