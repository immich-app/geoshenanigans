        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "10.4.3",
      "targets": [
        {
          "expr": "last_over_time(geocoder_build_duration_seconds{project=\"geoshenanigans\"}[$__range]) and on(trigger, runner) topk(1, last_over_time(geocoder_build_last_run_timestamp_seconds{project=\"geoshenanigans\"}[$__range]))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Last run duration",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Variants whose patch failed verification in the latest run that generated patches. Any fires the patch-verify-failed alert.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
