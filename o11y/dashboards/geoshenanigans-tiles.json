          "expr": "(sum(sum_over_time(tiles_cdn_hit_count:1m_sum_samples{project=\"geoshenanigans\", cluster=\"tiles\", request_type=\"tile\"}[1h])) or vector(0)) / sum(sum_over_time({__name__=~\"tiles_cdn_hit_count:1m_sum_samples|tiles_tile_request_invocation:1m_sum_samples\", project=\"geoshenanigans\", cluster=\"tiles\", z!=\"\"}[1h]))",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "id": 4
