{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "test": "vitest",
    "test:cov": "vitest --coverage",
    "test:node": "vitest run --config vitest.node.config.mts",
    "cf-typegen": "wrangler types",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "tsc --noEmit",
    "deploy:publish": "node --import=tsx src/deploy/publish.ts",
    "deploy:verify": "node --import=tsx src/deploy/verify.ts",
    "deploy:check": "node --import=tsx src/deploy/check.ts",
    "bunny:seed": "node --import=tsx src/bunny/cli/seed.ts",
    "bunny:manifest": "node --import=tsx src/bunny/cli/manifest.ts",
    "bunny:diff": "node --import=tsx src/bunny/cli/diff.ts",
    "bunny:sync": "node --import=tsx src/bunny/cli/sync.ts",
    "bunny:replication": "node --import=tsx src/bunny/cli/replication.ts",
    "bunny:status": "node --import=tsx src/bunny/cli/status.ts",
    "bunny:delete-prefix": "node --import=tsx src/bunny/cli/delete-prefix.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-istanbul": "^5.0.0",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "express": "^5.0.0",
    "prettier-plugin-organize-imports": "^4.0.0",
    "tsx": "^4.17.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite-node": "^6.0.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.862.0",
    "p-limit": "^7.0.0",
    "tldts": "^7.0.24",
    "undici": "^8.12.4"
  },
  "volta": {
    "node": "26.13.1"
  }
}
